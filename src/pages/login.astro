---
import Layout from '../layouts/Layout.astro';

const hasError = Astro.url.searchParams.has('error');
---

<Layout title="Iniciar sesión · Speed Copy">
  <main class="login">
    <form class="card" method="post" action="/api/login">
      <img src="/logo.jpeg" alt="Speed Copy 3023, C.A." class="logo" width="1600" height="1200" />
      <div class="cmyk-bar"></div>
      <h1>Calculadora de ventas</h1>

      {hasError && <p class="error" role="alert">Usuario o clave incorrectos.</p>}

      <label>
        <span>Usuario</span>
        <input class="input" name="usuario" autocomplete="username" autocapitalize="none" required autofocus />
      </label>
      <label>
        <span>Clave</span>
        <input class="input" name="clave" type="password" autocomplete="current-password" required />
      </label>

      <button class="btn btn-primary" type="submit">Entrar</button>
    </form>
  </main>
</Layout>

<style>
  .login {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: radial-gradient(ellipse at top, #0d2240 0%, var(--bg) 60%);
  }

  .card {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .logo {
    width: 100%;
    max-width: 240px;
    height: auto;
    margin: 0 auto;
    border-radius: 10px;
  }

  .cmyk-bar {
    border-radius: 4px;
  }

  h1 {
    margin: 0;
    font-size: 1.15rem;
    text-align: center;
    color: var(--muted);
    font-weight: 600;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .error {
    margin: 0;
    padding: 0.65rem 0.8rem;
    border-radius: 10px;
    background: rgba(255, 77, 109, 0.12);
    border: 1px solid rgba(255, 77, 109, 0.4);
    color: var(--danger);
    font-size: 0.9rem;
  }

  button {
    margin-top: 0.25rem;
  }
</style>
